{
	"manifest_version": 3,
	"name": "Cookie-Editor Gemini Sync",
	"version": "1.14.2",
	"author": "Moustachauve",
	"description": "Simple yet powerful Cookie Editor that allow you to quickly create, edit and delete cookies without leaving your tab.",
	"offline_enabled": true,
	"minimum_chrome_version": "120",
	"background": {
		"service_worker": "cookie-editor.js",
		"type": "module"
	},
	"action": {
		"default_icon": {
			"16": "icons/gemini-sync-16.png",
			"19": "icons/gemini-sync-19.png",
			"32": "icons/gemini-sync-32.png",
			"48": "icons/gemini-sync-48.png"
		},
		"default_title": "Gemini Web Sync",
		"default_popup": "interface/popup/cookie-list.html"
	},
	"side_panel": {
		"default_path": "interface/sidepanel/cookie-list.html"
	},
	"devtools_page": "interface/devtools/devtool.html",
	"options_ui": {
		"page": "interface/options/options.html"
	},
	"permissions": [
		"cookies",
		"tabs",
		"storage",
		"sidePanel",
		"alarms",
		"contextMenus"
	],
	"optional_host_permissions": [
		"<all_urls>"
	],
	"icons": {
		"16": "icons/gemini-sync-16.png",
		"19": "icons/gemini-sync-19.png",
		"32": "icons/gemini-sync-32.png",
		"48": "icons/gemini-sync-48.png",
		"128": "icons/gemini-sync-128.png"
	},
	"incognito": "split"
}