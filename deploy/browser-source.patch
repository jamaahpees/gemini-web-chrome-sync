+package app
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func TestBrowserSourceRotateAccountSkipsNetwork(t *testing.T) {
+	t.Setenv("GEMINI_BROWSER_COOKIE_SOURCE", "1")
+	var calls atomic.Int64
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		w.WriteHeader(http.StatusForbidden)
+	}))
+	defer server.Close()
+	proxyID, err := proxyCreate("browser-source-test", server.URL, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		_, _ = getDB().Exec(`DELETE FROM proxies WHERE id=?`, proxyID)
+		loadProxies()
+	})
+	original := "SAPISID=browser; __Secure-1PSID=browser; SIDCC=original"
+	id, err := accountAdd("browser", original, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = accountDelete(id) })
+	interval, names, err := rotateAccount(CookieAccount{ID: id, Cookie: original, ProxyID: proxyID})
+	if err != nil || interval != defaultRotateInterval || len(names) != 0 {
+		t.Errorf("rotation = (%v, %v, %v), want default interval and no changes", interval, names, err)
+	}
+	if calls.Load() != 0 {
+		t.Errorf("rotation made %d network requests", calls.Load())
+	}
+	if a := accountByID(id); a == nil || a.Cookie != original {
+		t.Fatal("rotation changed imported cookie")
+	}
+}
+
+func TestBrowserSourceUpdateAccountCookieNoop(t *testing.T) {
+	t.Setenv("GEMINI_BROWSER_COOKIE_SOURCE", "1")
+	original := "SAPISID=browser; __Secure-1PSID=browser; SIDCC=original"
+	id, err := accountAdd("browser", original, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = accountDelete(id) })
+	updateAccountCookie(id, strings.ReplaceAll(original, "original", "response"))
+	if a := accountByID(id); a == nil || a.Cookie != original {
+		t.Fatal("response cookie overwrote imported cookie")
+	}
+}
+
+func TestBrowserSourceResponseCookieRemainsOriginal(t *testing.T) {
+	original := "SAPISID=browser; SIDCC=original"
+	for _, mode := range []string{"1", "", "0", "true"} {
+		t.Run("mode="+mode, func(t *testing.T) {
+			t.Setenv("GEMINI_BROWSER_COOKIE_SOURCE", mode)
+			got := mergeSetCookie(original, []string{"SIDCC=response; Path=/", "NEW=response; Path=/"})
+			if mode == "1" {
+				if got != original {
+					t.Fatal("response merge changed browser-authoritative cookie")
+				}
+			} else if cookieValue(got, "SIDCC") != "response" || cookieValue(got, "NEW") != "response" {
+				t.Fatal("default response merge behavior changed")
+			}
+		})
+	}
+}
+
+func TestAdminCookiesImportStatus(t *testing.T) {
+	for _, tc := range []struct {
+		name, status, want string
+		code               int
+	}{
+		{"omitted", "", "enabled", 200},
+		{"enabled", "enabled", "enabled", 200},
+		{"disabled", "disabled", "disabled", 200},
+		{"invalid", "DISABLED", "", 400},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			before, _ := accountCount()
+			body := map[string]string{"label": "import", "cookie": "SAPISID=browser", "note": "test"}
+			if tc.status != "" {
+				body["status"] = tc.status
+			}
+			data, err := json.Marshal(body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			w := httptest.NewRecorder()
+			handleAdminCookies(w, httptest.NewRequest(http.MethodPost, "/admin/api/cookies", strings.NewReader(string(data))))
+			var result struct {
+				ID int64 `json:"id"`
+			}
+			_ = json.Unmarshal(w.Body.Bytes(), &result)
+			if result.ID > 0 {
+				t.Cleanup(func() { _ = accountDelete(result.ID) })
+			}
+			if w.Code != tc.code {
+				t.Fatalf("HTTP %d, want %d", w.Code, tc.code)
+			}
+			if tc.code == 400 {
+				if after, _ := accountCount(); after != before {
+					t.Fatal("invalid status inserted an account")
+				}
+				return
+			}
+			if a := accountByID(result.ID); a == nil || a.Status != tc.want {
+				t.Fatalf("import did not start with status %q", tc.want)
+			}
+		})
+	}
+}
